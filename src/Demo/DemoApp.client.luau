--!nonstrict
-- All values are interface examples. No avatar/world/game behavior is changed.
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local Blossom = require(ReplicatedStorage:WaitForChild('Blossom'))
local library = Blossom.new({Title = 'Blossom', Scale = 1, ReducedMotion = false})

local function changed(label)
    return function(value) print('[Blossom UI demo] ' .. label .. ': ' .. tostring(value)) end
end

local rage = library:AddPage({Id = 'rage', Title = 'Rage', Group = 'Combat'})
local ragebot = rage:AddSection({Id = 'ragebot', Title = 'Ragebot', Column = 1})
ragebot:AddToggle({Id = 'rage_enabled', Label = 'Enabled', Default = false, OnChanged = changed('Enabled')})
ragebot:AddToggle({Id = 'auto_shoot', Label = 'Auto Shoot', Default = true})
ragebot:AddToggle({Id = 'auto_scope', Label = 'Auto Scope'})
ragebot:AddToggle({Id = 'auto_reload', Label = 'Auto Reload', Default = true})
ragebot:AddToggle({Id = 'force_headshot', Label = 'Force Headshot', Disabled = true})
ragebot:AddToggle({Id = 'autowall', Label = 'Autowall', Default = true})
ragebot:AddSlider({Id = 'min_damage', Label = 'Min Damage', Minimum = 0, Maximum = 100, Default = 20, Unit = 'hp'})
ragebot:AddSlider({Id = 'hitchance', Label = 'Hitchance', Minimum = 0, Maximum = 100, Default = 85, Unit = '%'})
ragebot:AddDropdown({Id = 'target_selection', Label = 'Target Selection', Options = {'Closest to Crosshair', 'Closest Distance', 'Lowest Health'}, Default = 'Closest to Crosshair'})
ragebot:AddSlider({Id = 'max_distance', Label = 'Max Distance', Minimum = 0, Maximum = 2000, Step = 10, Default = 800})
local targeting = rage:AddSection({Id = 'targeting', Title = 'Targeting', Column = 1})
targeting:AddToggle({Id = 'visible_only', Label = 'Visible Only', Default = true})
targeting:AddToggle({Id = 'team_check', Label = 'Team Check', Default = true})

local silent = rage:AddSection({Id = 'silent_aim', Title = 'Silent Aim', Column = 2})
silent:AddToggle({Id = 'silent_enabled', Label = 'Enabled'})
silent:AddToggle({Id = 'use_fov', Label = 'Use FOV', Default = true})
silent:AddToggle({Id = 'draw_fov', Label = 'Draw FOV', Default = true})
silent:AddSlider({Id = 'fov_size', Label = 'FOV Size', Minimum = 0, Maximum = 360, Default = 120, Unit = 'px'})
silent:AddSlider({Id = 'silent_hitchance', Label = 'Hitchance', Minimum = 0, Maximum = 100, Default = 100, Unit = '%'})
silent:AddDropdown({Id = 'aim_point', Label = 'Aim Point', Options = {'Head', 'Torso', 'Upper Torso', 'Lower Torso', 'Left Arm', 'Right Arm', 'Left Leg', 'Right Leg'}, OnChanged = changed('Aim Point')})
silent:AddToggle({Id = 'prediction', Label = 'Prediction', Default = true})
silent:AddSlider({Id = 'prediction_amount', Label = 'Prediction Amount', Minimum = 0, Maximum = 3, Step = 0.1, Default = 1.2, Unit = 'x'})
local anti = rage:AddSection({Id = 'anti_aim', Title = 'Anti Aim', Column = 2})
anti:AddToggle({Id = 'anti_enabled', Label = 'Enabled'})
anti:AddDropdown({Id = 'pitch', Label = 'Pitch', Options = {'None', 'Up', 'Down'}})

local legit = library:AddPage({Id = 'legit', Title = 'Legit', Group = 'Combat'})
local assist = legit:AddSection({Id = 'assist', Title = 'Aim Assist', Column = 1})
assist:AddToggle({Id = 'assist_enabled', Label = 'Enabled'})
assist:AddSlider({Id = 'smoothness', Label = 'Smoothness', Minimum = 0, Maximum = 10, Step = 0.1, Default = 2})
local misc = legit:AddSection({Id = 'misc', Title = 'Misc', Column = 2})
misc:AddToggle({Id = 'jump_check', Label = 'Jump Check', Default = true})
misc:AddToggle({Id = 'flash_check', Label = 'Flash Check'})

local players = library:AddPage({Id = 'players', Title = 'Players', Group = 'Visuals'})
local chams = players:AddSection({Id = 'chams', Title = 'Chams', Column = 1})
chams:AddToggle({Id = 'chams_enabled', Label = 'Enabled'})
chams:AddDropdown({Id = 'box_style', Label = 'Box Style', Options = {'Outline', 'Corners'}})
local radar = players:AddSection({Id = 'radar', Title = 'Radar', Column = 2})
radar:AddSlider({Id = 'radar_size', Label = 'Radar Size', Minimum = 50, Maximum = 300, Default = 150})
library:AddPage({Id = 'effects', Title = 'Effects', Group = 'Visuals'})

local movement = library:AddPage({Id = 'movement', Title = 'Movement', Group = 'Player'})
local movementSection = movement:AddSection({Id = 'movement', Title = 'Movement', Column = 1})
movementSection:AddToggle({Id = 'speed', Label = 'Speed'})
movementSection:AddSlider({Id = 'speed_amount', Label = 'Speed Amount', Minimum = 0, Maximum = 100, Default = 16})
movementSection:AddDropdown({Id = 'speed_type', Label = 'Speed Type', Options = {'Default', 'Smooth', 'Stepped'}})
local bunny = movement:AddSection({Id = 'bunny_hop', Title = 'Bunny Hop', Column = 2})
bunny:AddToggle({Id = 'bunny_enabled', Label = 'Enabled'})
bunny:AddSlider({Id = 'strafe_strength', Label = 'Strafe Strength', Minimum = 0, Maximum = 100, Default = 30, Unit = '%'})
library:AddPage({Id = 'exploits', Title = 'Exploits', Group = 'Player'})

-- Foundation-only demo controls; these are not the recorded Profiles feature.
local settings = library:AddPage({Id = 'settings', Title = 'Settings'})
local demo = settings:AddSection({Id = 'demo', Title = 'UI Demo', Column = 1})
local name = demo:AddTextInput({Id = 'demo_name', Label = 'Demo name', Placeholder = 'Type a name', MaxLength = 40, OnChanged = changed('Name'), OnSubmitted = changed('Submitted')})
local status = demo:AddTextInput({Id = 'demo_status', Label = 'Last action', Default = 'Ready', Disabled = true})
demo:AddButton({Id = 'greet', Label = 'Test callback', OnClick = function() status:SetValue('Hello, ' .. (name:GetValue() ~= '' and name:GetValue() or 'Blossom')) end})
demo:AddButton({Id = 'reset_demo', Label = 'Reset demo', OnClick = function() name:SetValue(''); status:SetValue('Ready'); library:SetValue('min_damage', 20) end})
local menu = settings:AddSection({Id = 'menu', Title = 'Menu', Column = 2})
menu:AddDropdown({Id = 'ui_scale', Label = 'UI scale', Options = {'100%', '125%', '150%'}, OnChanged = function(value) library:SetScale(tonumber(value:sub(1, -2)) / 100) end})
menu:AddToggle({Id = 'demo_input_disabled', Label = 'Disable input', OnChanged = function(value) name:SetDisabled(value) end})
menu:AddButton({Id = 'accent_preview', Label = 'Preview warm accent', OnClick = function() library:SetTheme({Accent = Color3.fromRGB(217, 154, 105)}) end})
menu:AddButton({Id = 'restore_accent', Label = 'Restore blue accent', OnClick = function() library:SetTheme({Accent = Color3.fromRGB(116, 169, 227)}) end})
menu:AddButton({Id = 'unload', Label = 'Unload UI', OnClick = function() library:Destroy() end})

local destroying
destroying = script.Destroying:Connect(function()
    destroying:Disconnect()
    library:Destroy()
end)
