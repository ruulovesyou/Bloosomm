--!nonstrict
-- Native-engine assertions. Build tests/studio.project.json and press Play in Studio.
local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local Blossom = require(game:GetService('ReplicatedStorage'):WaitForChild('Blossom'))
local library = Blossom.new({ReducedMotion = true})
local first = library:AddPage({Id = 'first', Title = 'First', Group = 'Test'})
local second = library:AddPage({Id = 'second', Title = 'Second', Group = 'Test'})
local left = first:AddSection({Id = 'left', Title = 'Left', Column = 1})
local right = first:AddSection({Id = 'right', Title = 'Right', Column = 2})
local calls = 0
local toggle = left:AddToggle({Id = 'toggle', Label = 'Enabled', OnChanged = function() calls += 1 end})
local slider = left:AddSlider({Id = 'slider', Label = 'Amount', Minimum = -1, Maximum = 1, Step = 0.25})
local dropdown = right:AddDropdown({Id = 'dropdown', Label = 'Choice', Options = {'A', 'B', 'C'}})
local text = right:AddTextInput({Id = 'text', Label = 'Text', MaxLength = 3})
right:AddButton({Id = 'button', Label = 'Button', OnClick = function() calls += 1 end})
toggle:SetValue(true)
toggle:SetValue(true)
assert(calls == 1)
slider:SetValue(0.62)
assert(slider:GetValue() == 0.5)
dropdown:SetValue('B')
text:SetValue('a🌸bc')
assert(text:GetValue() == 'a🌸b')
library:SelectPage('second')
assert(not first.Frame.Visible and second.Frame.Visible)
library:SelectPage('first')
assert(toggle:GetValue() and dropdown:GetValue() == 'B')
toggle:SetDisabled(true)
assert(not toggle.Frame.Toggle.Interactable)
toggle:SetDisabled(false)
assert(toggle.Frame.Toggle.Interactable)
assert(#library:GetControls() == 5)
assert(not pcall(function() left:AddToggle({Id = 'toggle', Label = 'Duplicate'}) end))
library:SetTheme({Accent = Color3.fromRGB(240, 150, 90)})
library:SetScale(1.25)
RunService.Heartbeat:Wait()
RunService.Heartbeat:Wait()
assert(first.Columns[1].AbsoluteSize.X > 0 and first.Columns[2].AbsoluteSize.X > 0)
assert(left.Frame.AbsoluteSize.Y > 0 and right.Frame.AbsoluteSize.Y > 0)
assert(toggle.Frame.Toggle.Pill.BackgroundColor3 == Color3.fromRGB(240, 150, 90))
local gui = Players.LocalPlayer.PlayerGui:FindFirstChild('Blossom')
assert(gui)
library:SetVisible(false)
assert(not gui.Viewport.Window.Visible)
library:SetVisible(true)
library:Destroy()
library:Destroy()
assert(gui.Parent == nil)
assert(not pcall(function() toggle:SetValue(false) end))
print('PASS Blossom Studio smoke: API, values, layout, theme, disabled, visibility, destroy')
